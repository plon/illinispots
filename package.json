{
  "name": "illinispots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names client,server --prefix-colors cyan,magenta \"vite\" \"bun --hot src/server/index.ts\"",
    "build": "vite build && bun run typecheck",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "preview": "bun run build && bun run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test",
    "test:watch": "NODE_ENV=test bun test --watch",
    "check": "bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@posthog/react": "^1.10.5",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/bun": "^10.70.0",
    "@sentry/hono": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.45.6",
    "@tanstack/react-query": "^5.71.1",
    "@tanstack/react-router": "^1.170.31",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hono": "^4.13.3",
    "lucide-react": "^0.454.0",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.29.0",
    "posthog-js": "^1.422.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/bun": "^1.3.9",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "postcss": "^8",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2"
  }
}
