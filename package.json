{
  "name": "illinispots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names client,server --prefix-colors cyan,magenta \"vite\" \"bun --hot src/server/index.ts\"",
    "build": "vite build && bun run typecheck",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "preview": "bun run build && bun run start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test ./src",
    "test:watch": "NODE_ENV=test bun test --watch ./src",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@posthog/react": "^1.11.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/bun": "11.8.0",
    "@sentry/hono": "11.8.0",
    "@sentry/react": "11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.33.0",
    "posthog-js": "^1.438.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
