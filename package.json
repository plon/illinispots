{
  "name": "illinispots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names client,server --prefix-colors cyan,magenta \"vite\" \"bun --hot src/server/index.ts\"",
    "build": "vite build && bun run typecheck",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "preview": "bun run build && bun run start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test",
    "test:watch": "NODE_ENV=test bun test --watch",
    "check": "bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@posthog/react": "^1.11.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/bun": "^10.74.0",
    "@sentry/hono": "^10.74.0",
    "@sentry/react": "^11.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.31.0",
    "posthog-js": "^1.434.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/bun": "^1.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
