# Runtime configuration (Hono API server - read-only queries)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
VITE_MAPBOX_ACCESS_TOKEN=your_public_mapbox_token
VITE_MAPBOX_STYLE_URL=mapbox://styles/your-user/your-style

# Data pipeline configuration (Python ETL scrapers - required for database write operations)
# SUPABASE_SECRET_KEY=your_service_role_key

# Optional runtime & observability configuration
APP_ENV=development
VITE_APP_ENV=development
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Set to true for local verification builds that should not publish source maps.
SENTRY_DISABLE_AUTO_UPLOAD=false
